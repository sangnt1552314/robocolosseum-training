#!/bin/bash
#PBS -P CFP05-CF-002
#PBS -j oe
#PBS -k oed
#PBS -N colosseum-lerobot-g05-so101-stack-white_bowls-100episodes
#PBS -q auto
#PBS -l select=1:ngpus=1
#PBS -l walltime=20:00:00

cd $PBS_O_WORKDIR

# ngc 24.04 ships Python 3.10, matching the g05 virtualenv (the 2.7.0 image is 3.12).
image="/app1/common/singularity-img/hopper/pytorch/pytorch_2.3.0_cuda_12.4_ngc_24.04.sif"

module load singularity

# Load secrets/config from a .env file (KEY=VALUE lines). set -a auto-exports them.
ENV_FILE="$PBS_O_WORKDIR/.env"
if [ -f "$ENV_FILE" ]; then
    set -a
    source "$ENV_FILE"
    set +a
fi
: "${HF_TOKEN:?HF_TOKEN not found. Add it to $ENV_FILE or set push_to_hub=false.}"

LOG_DIR='./logs/g05-so101-stack-white_bowls-100episodes'
mkdir -p $LOG_DIR

singularity exec -e --nv \
--env HF_HOME=/scratch/e1583535/cache \
--env HF_TOKEN="$HF_TOKEN" \
--env TMPDIR=/scratch/e1583535/tmp \
--env TEMP=/scratch/e1583535/tmp \
--env TMP=/scratch/e1583535/tmp \
$image bash << 'EOF' > $LOG_DIR/stdout.$PBS_JOBID.log 2> $LOG_DIR/stderr.$PBS_JOBID.log

mkdir -p /scratch/e1583535/tmp

if [ -d "/scratch/e1583535/virtualenvs/g05" ]; then
    source /scratch/e1583535/virtualenvs/g05/bin/activate
fi

echo "Starting policy worker at $(date)"
echo "Running on host: $(hostname)"
echo "GPU info:"
nvidia-smi --query-gpu=name,memory.total,memory.free --format=csv,noheader,nounits || echo "No GPU detected"

# The g05 training script activates its own virtualenv (/scratch/e1583535/virtualenvs/g05).
bash scripts/g05/train_so101_stack_white_bowls_100episodes.sh
EOF
